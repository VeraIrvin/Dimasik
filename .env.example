ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
BACKEND_URL=http://127.0.0.1:8787
DATABASE_PATH=data/dimasik.sqlite
FRONTEND_ORIGIN=http://localhost:3000

# Optional S3-compatible object storage for post images (Selectel S3 or a local
# S3-compatible server). Leave ALL five values empty to run without images:
# upload endpoints answer 503 and posts work without image attachments. Set all
# five together to enable uploads. Example values:
#   S3_ENDPOINT=https://s3.ru-6.storage.selcloud.ru
#   S3_REGION=ru-6
# Keep S3_ENDPOINT bucket-less: addressing is virtual-hosted, so the bucket is
# prepended as a host subdomain (`<bucket>.s3.ru-6.storage.selcloud.ru`).
# Credentials are runtime secrets; copy this file to .env (git-ignored).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
