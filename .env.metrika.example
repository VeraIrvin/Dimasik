# Server-only Yandex Metrika Reporting API configuration.
# Copy to .env.metrika.local, fill the token, then restart the backend.
# OAuth token needs metrika:read and access to the selected counter.
# Never put the token in NEXT_PUBLIC_* variables or commit .env.metrika.local.
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=113584085
