# Copy this file to .env.compose and fill in real values, then run:
#
#   docker compose --env-file .env.compose up -d --build
#
# .env.compose is git-ignored. Never commit real credentials.
#
# The public hostname must already have an A/AAAA record pointing at this host,
# and TCP ports 80 and 443 must be reachable from the internet for the ACME
# HTTP-01 challenge and HTTPS traffic.

# Public hostname served by Traefik (no scheme, no trailing slash).
DOMAIN=portal.example.com

# Email registered with Let's Encrypt for expiry/account notices.
ACME_EMAIL=admin@example.com

# ACME directory URL.
#
# While testing, use the staging directory to avoid production rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Staging certificates are NOT trusted by browsers. Switching back to
# production issues new certificates; to discard staging account/certificate
# state first, stop the stack and delete the `letsencrypt` volume (this also
# removes valid production certificates, so only do it deliberately).
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Admin login for the backend. Unset credentials disable login entirely, and a
# session secret shorter than 32 characters silently disables session minting
# (login answers 503). Generate a secret with: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Fixed in-cluster wiring (do not change without also rebuilding the frontend):
#   BACKEND_URL=http://backend:8787   (compose service DNS name)
# The backend database lives in the `dimasik-data` volume at
# /var/lib/dimasik/dimasik.sqlite. The four first-bootstrap JSON documents
# (data/*.json, gitignored) are baked into the backend image at /app/seed when
# present and are only read when the database has never been imported:
#   - Real content: place the four documents in data/ before the first build.
#   - Intentional empty install: build without them, then run once
#     `docker compose --env-file .env.compose run --rm backend import --fresh`.
# See README for first start, backup, migration and update steps.

# Optional: S3-compatible object storage for post images (Selectel S3).
#
# Leave ALL five values empty (or omit them) to run without images: upload
# endpoints answer 503 and posts work without image attachments. Set all five
# together to enable uploads.
#
# Recommended Selectel setup:
#   - PRIVATE bucket (no public read), dedicated to this portal.
#   - Credentials/role scoped to the portal prefix with GET/PUT/DELETE only.
#   - Endpoint https://s3.ru-6.storage.selcloud.ru and region ru-6; addressing
#     is virtual-hosted, so the bucket becomes a host subdomain
#     (`<bucket>.s3.ru-6.storage.selcloud.ru`), never a URL path segment.
#   - Browser CORS is NOT required: the browser only talks to the backend,
#     which uploads/downloads the objects itself and hands the page
#     short-lived signed URLs (compose gives the backend outbound access
#     through the backend-only `egress` network).
#
# Runtime-only secrets: compose passes these to the backend container through
# `environment`; they are NEVER image build args. .env.compose is git-ignored.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
